NODE_ENV=development
PORT=3001

# MongoDB URI
# Khi chạy trực tiếp (ngoài Docker): mongodb://localhost:27017/docuguard
# Khi chạy trong Docker Compose:     mongodb://mongodb:27017/docuguard
MONGODB_URI=mongodb://localhost:27017/docuguard

# URL gốc của n8n
# Khi chạy trực tiếp: http://localhost:5678
# Khi chạy trong Docker Compose: http://n8n:5678
N8N_BASE_URL=http://localhost:5678

# Secret để xác thực webhook từ n8n gọi vào backend
# Tạo bằng: openssl rand -hex 32
# KHÔNG ĐƯỢC để trống trong production
N8N_WEBHOOK_SECRET=change-me-in-production

# Origin của frontend được phép gọi API (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Thư mục lưu file tài liệu upload (relative hoặc absolute path)
# Docker volume sẽ mount vào đường dẫn này
DOCUMENT_STORAGE_PATH=./storage/documents
